{
  "name": "anthropic-error-overloaded",
  "description": "Hand-authored: upstream 529 with a JSON error body.",
  "request": {
    "method": "POST",
    "path": "/v1/messages",
    "headers": { "content-type": "application/json" },
    "body": {
      "model": "claude-sonnet-4",
      "max_tokens": 64,
      "stream": true,
      "messages": [{ "role": "user", "content": "trigger the overload path" }]
    }
  },
  "response": {
    "status": 529,
    "contentType": "application/json",
    "json": { "type": "error", "error": { "type": "overloaded_error", "message": "Overloaded" } }
  }
}
